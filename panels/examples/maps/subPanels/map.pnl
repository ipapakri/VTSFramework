E "#uses \"classes/Map/MapNavigator.ctl\"
#uses \"classes/Map/MapObject.ctl\"

MapNavigator mapNavigator;

void initialize()
{
  addDatapoints();

  mapNavigator.setMapShape(this);
  mapEWO.workOffline(false);
  /*if(isDollarDefined(\"$lat\") && isDollarDefined(\"$lon\") && isDollarDefined(\"$alt\"))
  {
    DebugTN(__FUNCTION__, __LINE__, $lat, $lon, $alt, (float)$lat, (float)$lon, 1500);
    mapEWO.centerOn((float)$lat, (float)$lon, (float)$alt);
  }
  else
  {
    mapNavigator.goThere();
  }*/
  mapNavigator.goThere();
}

void addDatapoints()
{
  dyn_string dpes = mapNavigator.getDPEnames();

  for (int i = 1; i <= dynlen(dpes); ++i)
  {
    string dp = dpes[i];
    dyn_string views;
    dpGet(dp + \".Internal.views\", views);
    shared_ptr<MapObject> mapObject = mapNavigator.getMapObject(dpes[i]);
    for(int j=1; j<=dynlen(views); j++)
    {
      string prefix = \"min\";
      dyn_string viewContent = strsplit(views[j], \",\");
      string panel = viewContent[1];
      string options = viewContent[2];
      string methods;
      if(dynlen(viewContent) > 2)
      {
        methods = viewContent[3];
      }
      addSymbol(self, panel, \"symb_\" + i + \"_\" + j, makeDynString(\"$DP:\" + dpes[i], \"$Number:1\", \"$cnsPath:\" + mapObject.getCnsPath()), 10, 10, 0, 1, 1, \"mapEWO\");
      //invokeMethod(getShape(myModuleName(), myPanelName(), \"symb_\" + i + \"_\" + j), \"setIndicatorDirection\", 1);
      if(methods != \"\")
      {
        shape s = getShape(myModuleName(), myPanelName(), \"symb_\" + i + \"_\" + j);
        dyn_string methodsContent = strsplit(methods, \"|\");
        mapping m;
        for(int k=1; k<=dynlen(methodsContent); k++)
        {
          dyn_string method = strsplit(methodsContent[k], \":\");
          DebugTN(__FUNCTION__, __LINE__, \"Invoking method: \" + method[1] + \" \", method[2]);
          invokeMethod(s, method[1], (int)method[2]);
        }
      }

      dyn_string optionsContent = strsplit(options, \"|\");
      mapping m;
      for(int k=1; k<=dynlen(optionsContent); k++)
      {
        dyn_string option = strsplit(optionsContent[k], \":\");
        m[option[1]] = option[2];
      }

      mapEWO.addSymbol(\"symb_\" + i + \"_\" + j, mapObject.getCoordinates(), m);
    }
  }
