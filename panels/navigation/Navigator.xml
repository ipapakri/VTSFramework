  <script name="ScopeLib" isEscaped="1"><![CDATA[#uses &quot;classes/navigation/EYDAPCompositeNavigator&quot;
#uses &quot;classes/navigation/NavigationController&quot;
#uses &quot;classes/navigation/EYDAPTreeNavigator&quot;
#uses &quot;classes/navigation/MapNavigator&quot;
#uses &quot;classes/navigation/PanelNavigator&quot;
#uses &quot;classes/navigation/catalog/CnsCatalog&quot;
#uses &quot;classes/AreaManagement/AreaManager.ctl&quot;

const string MAIN_MODULE_NAME = &quot;Main_Module&quot;;
const string MAP_MODULE_NAME = &quot;Map_Module&quot;;
const string VIEW_NAME = &quot;System1.WasteWaterPumpStations:PumpStations&quot;;

string rootId;
string rootLabel;

shared_ptr&lt;AreaManager&gt; areaManager;
string connectedUser;

shared_ptr&lt;NavigationController&gt; navigationController = nullptr;

int gNavDepth;

initialize()
{
  EMBEDDED_MODULE1.ModuleName(MAP_MODULE_NAME);
  EMBEDDED_MODULE2.ModuleName(MAIN_MODULE_NAME);

  shared_ptr&lt;CnsCatalog&gt; catalog = new CnsCatalog();
  shared_ptr&lt;CnsNode&gt; root = catalog.loadView(VIEW_NAME);

  navigationController = NavigationController::instance(myModuleName() + &quot;_&quot; + MAP_MODULE_NAME);
  navigationController.setNavigationCatalog(catalog);
  // navigationController.setGuard(yourAreaGuard);  // optional

  shared_ptr&lt;EYDAPTreeNavigator&gt; treeView = new EYDAPTreeNavigator(
    getShape(myModuleName(), myPanelName(), &quot;TREE1&quot;));
  treeView.populate(root);
  navigationController.addView(treeView);

  // Omit this block for panel-only projects
  shared_ptr&lt;MapNavigator&gt; mapView = MapNavigator::instance(myModuleName() + &quot;_&quot; + MAP_MODULE_NAME);
  mapView.setMapModule(getShape(myModuleName(), myPanelName(), &quot;EMBEDDED_MODULE1&quot;));
  mapView.populate(root);
  //RootPanelOnModule(&quot;examples/maps/start.xml&quot;, &quot;&quot;, &quot;Map_Module&quot;, makeDynString());
  RootPanelOnModule(&quot;examples/maps/subPanels/map.xml&quot;, &quot;&quot;, MAP_MODULE_NAME, makeDynString(&quot;$NavigatorName:&quot; + myModuleName() + &quot;_&quot; + MAP_MODULE_NAME));

  // Omit this block for map-only projects
  shared_ptr&lt;PanelNavigator&gt; panelView = new PanelNavigator(
    getShape(myModuleName(), myPanelName(), &quot;EMBEDDED_MODULE2&quot;));

  shared_ptr&lt;EYDAPCompositeNavigator&gt; eydapCompositeNavigator = new EYDAPCompositeNavigator(mapView, panelView);
  navigationController.addView(eydapCompositeNavigator);
  //navigationController.addView(mapView);
  //navigationController.addView(panelView);

  //navigationController.navigate(root.getCnsPath()));
}]]></script>
  <script name="Initialize" isEscaped="1"><![CDATA[/**
